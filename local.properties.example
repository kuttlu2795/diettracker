# Android Studio auto-creates local.properties with sdk.dir the first time you open the
# project. Add these three lines to that same file (do NOT commit it - it's git-ignored).
#
# Free key sign-up:
#   Edamam Nutrition Analysis API : https://developer.edamam.com  (free tier)
#   Spoonacular Food API          : https://spoonacular.com/food-api (free tier, 150 pts/day)
#   Google Gemini API             : https://aistudio.google.com/apikey (genuinely free tier, no card needed)
#
# Without these keys the app still works using the free, keyless Open Food Facts API for
# barcode/packaged-food lookups - you'll just miss natural-language fruit/home-food search
# results, the AI fallback for anything not in a database, and the AI-generated daily
# meal-plan table until you add them.

sdk.dir=/path/to/your/Android/sdk

EDAMAM_APP_ID=your_edamam_app_id_here
EDAMAM_APP_KEY=your_edamam_app_key_here
SPOONACULAR_API_KEY=your_spoonacular_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
